@startuml
' HU-13 · Cancelación de una reserva (versión ligera)
' Muestra la ejecución por parte del personal, que es la que cambia el
' estado de la reserva.
hide footbox

actor "Personal" as PER
boundary "IU-13" as UI <<interfaz>>
control "ControlReservas" as CTRL <<control>>
entity "Reserva" as E_RESERVA <<entidad>>
database "reserva" as T_RESERVA <<tabla>>

PER -> UI : cancela la reserva con motivo
UI -> CTRL : ejecutarCancelacion(idReserva, motivo)
CTRL -> E_RESERVA : bloquear(idReserva)
E_RESERVA -> T_RESERVA : SELECT ... FOR UPDATE
T_RESERVA --> E_RESERVA : reserva actual
E_RESERVA --> CTRL : estado cancelable
CTRL -> E_RESERVA : cambiarEstado(cancelada, motivo)
E_RESERVA -> T_RESERVA : UPDATE ...
T_RESERVA --> E_RESERVA : fila actualizada
E_RESERVA --> CTRL : reserva cancelada
CTRL --> UI : cupo liberado
UI --> PER : confirmación
@enduml
