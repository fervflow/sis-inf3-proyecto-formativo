@startuml
' HU-03 · Consulta de disponibilidad (versión ligera)
hide footbox

actor "Turista" as TUR
boundary "IU-03" as UI <<interfaz>>
control "ControlDisponibilidad" as CTRL <<control>>
entity "Salida" as E_SALIDA <<entidad>>
database "salida" as T_SALIDA <<tabla>>

TUR -> UI : consulta destino y fecha
UI -> CTRL : consultarDisponibilidad(criterios)
CTRL -> E_SALIDA : obtenerSalidas(criterios)
E_SALIDA -> T_SALIDA : SELECT ...
T_SALIDA --> E_SALIDA : salidas
E_SALIDA -> E_SALIDA : calcularCupoDisponible()
E_SALIDA --> CTRL : salidas con cupo
CTRL --> UI : resultados
UI --> TUR : disponibilidad
@enduml
