@startuml
' HU-03 · Consulta de disponibilidad
hide footbox
autonumber
skinparam maxMessageSize 160

actor "Turista" as TUR
actor "Personal" as PER
boundary "IU-03 · Consultar disponibilidad" as UI <<interfaz>>
control "ControlDisponibilidad" as CTRL <<control>>
entity "Paquete" as E_PAQUETE <<entidad>>
entity "Salida" as E_SALIDA <<entidad>>
entity "Reserva" as E_RESERVA <<entidad>>
database "paquete" as T_PAQUETE <<tabla>>
database "salida" as T_SALIDA <<tabla>>
database "reserva" as T_RESERVA <<tabla>>

TUR -> UI : ingresa destino, fecha y N.º de pasajeros
PER -> UI : consulta asistida
UI -> CTRL : consultarDisponibilidad(criterios)
CTRL -> E_PAQUETE : buscarPaquetes(criterios)
E_PAQUETE -> T_PAQUETE : SELECT ...
T_PAQUETE --> E_PAQUETE : paquetes
E_PAQUETE --> CTRL : lista de paquetes

loop Para cada paquete encontrado
    CTRL -> E_SALIDA : listarSalidas(idPaquete, fecha)
    E_SALIDA -> T_SALIDA : SELECT ...
    T_SALIDA --> E_SALIDA : salidas
    E_SALIDA -> E_RESERVA : contarPasajerosActivos(idSalida)
    E_RESERVA -> T_RESERVA : SELECT SUM(cantidad_pasajeros)
    T_RESERVA --> E_RESERVA : ocupados
    E_RESERVA --> E_SALIDA : ocupados
    E_SALIDA -> E_SALIDA : cupoDisponible = cupo_maximo - ocupados
    E_SALIDA --> CTRL : salida con disponibilidad
end

CTRL --> UI : paquetes y cupos disponibles
UI --> TUR : resultados de la consulta
UI --> PER : resultados de la consulta

alt Sin coincidencias
    CTRL --> UI : lista vacía
    UI --> TUR : mensaje «No hay disponibilidad»
end
@enduml
