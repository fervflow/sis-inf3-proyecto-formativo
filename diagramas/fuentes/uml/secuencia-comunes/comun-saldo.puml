@startuml
' Común · Consultar pagos y calcular saldo
hide footbox
autonumber
skinparam maxMessageSize 150

control "ControlPagos" as CTRL <<control>>
entity "Pago" as E_PAGO <<entidad>>
database "pago" as T_PAGO <<tabla>>

CTRL -> E_PAGO : calcularSaldo(idReserva, monto_total)
E_PAGO -> T_PAGO : SELECT tipo, monto
T_PAGO --> E_PAGO : anticipo y saldo
E_PAGO -> E_PAGO : totalPagado = anticipo + saldo
E_PAGO -> E_PAGO : saldoPendiente = monto_total - totalPagado
E_PAGO --> CTRL : totalPagado y saldoPendiente
@enduml
