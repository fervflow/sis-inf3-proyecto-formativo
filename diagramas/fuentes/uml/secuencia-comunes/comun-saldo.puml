@startuml
' Común · Consultar pagos y calcular saldo
hide footbox
autonumber
skinparam maxMessageSize 150

control "ControlPagos" as CTRL <<control>>
entity "Pago" as E_PAGO <<entidad>>
database "pago" as T_PAGO <<tabla>>

CTRL -> E_PAGO : calcularSaldo(idReserva, monto_total)
E_PAGO -> T_PAGO : SELECT tipo, monto, estado
T_PAGO --> E_PAGO : anticipo, saldo y estado del pago
E_PAGO -> E_PAGO : totalValidado = SUM(monto) WHERE estado = 'validado'
E_PAGO -> E_PAGO : saldoPendiente = monto_total - totalValidado
E_PAGO --> CTRL : totalValidado y saldoPendiente

note right of CTRL
    El saldo pendiente se calcula sobre los
    pagos validados. Un pago registrado por el
    cliente todavía no se considera cobrado.
end note
@enduml
