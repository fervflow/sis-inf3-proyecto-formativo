@startuml
title HU-06 · Registro de reservas con validación de cupos
' Dos canales de ingreso, un mismo proceso: la solicitud web exige una
' cuenta de cliente (HU-15) y nace pendiente, con vencimiento de 24 horas
' y el pago del anticipo como respaldo (HU-14). La confirma el personal
' (HU-17).
hide footbox
autonumber
skinparam maxMessageSize 175

actor "Cliente" as TUR
actor "Personal" as PER
boundary "IU-06 · Registrar reserva" as UI <<interfaz>>
control "ControlReservas" as CTRL <<control>>
entity "Cliente" as E_CLIENTE <<entidad>>
entity "Salida" as E_SALIDA <<entidad>>
entity "Reserva" as E_RESERVA <<entidad>>
entity "Pasajero" as E_PASAJERO <<entidad>>
entity "ReservaPasajero" as E_RESERVA_PASAJERO <<entidad>>
database "cliente" as T_CLIENTE <<tabla>>
database "salida" as T_SALIDA <<tabla>>
database "reserva" as T_RESERVA <<tabla>>
database "pasajero" as T_PASAJERO <<tabla>>
database "reserva_pasajero" as T_RESERVA_PASAJERO <<tabla>>

alt Sin sesión
    TUR -> UI : solicita la reserva
    UI --> TUR : redirección a ingresar o crear cuenta (RN-RES-17)
else Sesión del cliente válida (HU-15)
    TUR -> UI : solicita la reserva desde su cuenta
    UI -> CTRL : registrarReserva(datos, origen = 'web')
else Atención del personal
    PER -> UI : selecciona cliente, salida y pasajeros
    UI -> CTRL : registrarReserva(datos, origen = 'personal')
end

group Transacción de registro
    CTRL -> E_CLIENTE : validarClienteYFicha(origen)
    E_CLIENTE -> T_CLIENTE : SELECT ... la ficha la resuelve\nla cuenta del cliente (web)\no el id elegido (personal)
    T_CLIENTE --> E_CLIENTE : cliente activo
    E_CLIENTE --> CTRL : cliente válido

    CTRL -> E_SALIDA : bloquearSalida(idSalida)
    E_SALIDA -> T_SALIDA : SELECT ... FOR UPDATE\nWHERE paquete.estado = 'activo'\nAND salida.estado IN ('programada', 'confirmada')\nAND fecha_salida >= CURRENT_DATE
    T_SALIDA --> E_SALIDA : cupo_maximo
    E_SALIDA -> E_RESERVA : contarPasajerosActivos(idSalida)
    E_RESERVA -> T_RESERVA : SELECT desde vista_disponibilidad_salida
    T_RESERVA --> E_SALIDA : pasajeros ocupados
    E_SALIDA -> E_SALIDA : cupoDisponible = cupo_maximo - ocupados

    alt Paquete inactivo, salida pasada o no reservable
        E_SALIDA --> CTRL : no reservable
        CTRL --> UI : error «La salida no admite reservas»
        UI --> PER : informar al cliente
    else Cupo insuficiente
        E_SALIDA --> CTRL : no disponible
        CTRL --> UI : error «Cupo insuficiente»
        UI --> PER : informar al cliente
    else Cupo suficiente
        E_SALIDA --> CTRL : disponible
        CTRL -> E_RESERVA : verificarSolicitudUnica(idCliente, idSalida)
        E_RESERVA -> T_RESERVA : SELECT ... WHERE estado = 'pendiente'
        T_RESERVA --> E_RESERVA : solicitud existente

        alt Ya existe una solicitud activa del mismo cliente
            E_RESERVA --> CTRL : solicitud duplicada
            CTRL --> UI : error «Ya existe una solicitud para esta salida»
            UI --> PER : ofrecer modificar la solicitud existente
            UI --> TUR : ofrecer modificar la solicitud existente
        else Sin duplicidad
            E_RESERVA --> CTRL : sin duplicidad
            CTRL -> E_RESERVA : crear(idSalida, cantidad, monto, origen)
            E_RESERVA -> T_RESERVA : INSERT ... estado 'pendiente',\nfecha_expiracion = now() + 24 h,\nfirma de la cuenta que la registra
            T_RESERVA --> E_RESERVA : id_reserva
            E_RESERVA --> CTRL : reserva creada

            loop Por cada pasajero (canal personal)
                CTRL -> E_PASAJERO : registrarPasajero(datos)
                E_PASAJERO -> T_PASAJERO : INSERT ...
                T_PASAJERO --> E_PASAJERO : id_pasajero
                CTRL -> E_RESERVA_PASAJERO : vincular(idReserva, idPasajero)
                E_RESERVA_PASAJERO -> T_RESERVA_PASAJERO : INSERT ...
                T_RESERVA_PASAJERO --> E_RESERVA_PASAJERO : vínculo creado
            end

            CTRL --> UI : código de reserva y fecha de vencimiento
            UI --> PER : reserva pendiente registrada
            UI --> TUR : solicitud registrada; sigue el pago (HU-14)
        end
    end
end

note right of CTRL
    La reserva nace pendiente en los dos
    canales. En el web firma la cuenta del
    cliente (RN-RES-10); el pago del anticipo
    la respalda (HU-14) y la confirma el
    personal (HU-17). Si no se confirma dentro
    del plazo, pasa a vencida y libera el cupo.
end note

note right of E_RESERVA
    El bloqueo de la fila de salida impide
    que dos registros simultáneos superen la
    capacidad, sin importar el canal.
end note
@enduml
