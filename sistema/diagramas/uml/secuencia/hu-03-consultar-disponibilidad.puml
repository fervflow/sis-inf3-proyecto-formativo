@startuml
title HU-03 · Consulta de disponibilidad
' Cliente en acceso directo y consulta asistida por el personal.
' El mismo criterio de disponibilidad se aplica a los dos canales.
hide footbox
autonumber
skinparam maxMessageSize 170

actor "Turista" as TUR
actor "Personal" as PER
boundary "IU-03 · Consultar disponibilidad" as UI <<interfaz>>
control "ControlDisponibilidad" as CTRL <<control>>
entity "Paquete" as E_PAQUETE <<entidad>>
entity "Salida" as E_SALIDA <<entidad>>
entity "Reserva" as E_RESERVA <<entidad>>
database "paquete" as T_PAQUETE <<tabla>>
database "salida" as T_SALIDA <<tabla>>
database "reserva" as T_RESERVA <<tabla>>

TUR -> UI : iniciar sesión (HU-08)
UI -> CTRL : autenticar(credenciales)

alt Credenciales no válidas
    CTRL --> UI : error «Acceso denegado»
    UI --> TUR : volver a intentarlo
else Sesión iniciada
    TUR -> UI : indica destino, fecha y N.º de pasajeros
    PER -> UI : consulta asistida en la oficina
    UI -> CTRL : consultarDisponibilidad(criterios)
    CTRL -> E_PAQUETE : buscarPaquetes(criterios)
    E_PAQUETE -> T_PAQUETE : SELECT ... WHERE estado = 'activo'
    T_PAQUETE --> E_PAQUETE : paquetes activos
    E_PAQUETE --> CTRL : lista de paquetes

    alt Sin coincidencias
        CTRL --> UI : lista vacía
        UI --> TUR : mensaje «No hay disponibilidad»
    else Hay coincidencias
        loop Por cada paquete encontrado
            CTRL -> E_SALIDA : listarSalidas(idPaquete, fecha)
            E_SALIDA -> T_SALIDA : SELECT ... WHERE estado IN ('programada', 'confirmada')
            T_SALIDA --> E_SALIDA : salidas programadas
            E_SALIDA -> E_RESERVA : contarPasajerosActivos(idSalida)
            E_RESERVA -> T_RESERVA : SELECT SUM(cantidad_pasajeros)\nWHERE estado IN ('pendiente', 'confirmada')
            T_RESERVA --> E_RESERVA : pasajeros ocupados
            E_RESERVA --> E_SALIDA : ocupados
            E_SALIDA -> E_SALIDA : cupoDisponible = cupo_maximo - ocupados
            E_SALIDA --> CTRL : salida con cupo disponible
        end

        CTRL --> UI : paquetes, salidas y cupos disponibles
        UI --> TUR : resultados de la consulta
        UI --> PER : resultados para la atención en oficina
    end
end

note right of CTRL
    El cálculo no distingue el canal: una
    solicitud pendiente del cliente ocupa
    cupo igual que una reserva del personal.
    Las reservas vencidas y canceladas no
    se cuentan (vista_disponibilidad_salida).
end note
@enduml
