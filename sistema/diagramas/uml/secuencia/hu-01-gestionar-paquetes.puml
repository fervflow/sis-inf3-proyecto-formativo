@startuml
title HU-01 · Gestión de paquetes turísticos
' El borrador puede estar incompleto. Para publicar se exige destino,
' descripción, itinerario y al menos un servicio. El código lo genera la
' base; el recorrido se arma con lugares y paradas.
hide footbox
autonumber
skinparam maxMessageSize 175

actor "Administrador" as ADM
boundary "IU-01 · Gestionar paquete" as UI <<interfaz>>
control "ControlPaquetes" as CTRL <<control>>
entity "Paquete" as E_PAQUETE <<entidad>>
entity "Lugar" as E_LUGAR <<entidad>>
entity "Servicio" as E_SERVICIO <<entidad>>
entity "PaqueteServicio" as E_PAQUETE_SERVICIO <<entidad>>
database "paquete" as T_PAQUETE <<tabla>>
database "paquete_parada" as T_PARADA <<tabla>>
database "lugar" as T_LUGAR <<tabla>>
database "servicio" as T_SERVICIO <<tabla>>
database "paquete_servicio" as T_PAQUETE_SERVICIO <<tabla>>

ADM -> UI : abre el alta o la edición
UI -> CTRL : guardarPaquete(datos, destinos, servicios)

CTRL -> E_LUGAR : validarLugares(ids)
E_LUGAR -> T_LUGAR : SELECT ... WHERE activo = true
T_LUGAR --> E_LUGAR : lugares válidos
E_LUGAR --> CTRL : lugares válidos

CTRL -> E_PAQUETE : validarPrecioYDuracion()
E_PAQUETE --> CTRL : precio > 0 y duración válida

alt Estado activo
    CTRL -> E_PAQUETE : validarContenidoPublicable()
    E_PAQUETE --> CTRL : destino, descripción, itinerario y servicios

    alt Falta contenido obligatorio
        CTRL --> UI : error «Paquete incompleto»
        UI --> ADM : completar destino, itinerario o servicios
    else Contenido completo
        CTRL -> E_SERVICIO : validarServicios(ids)
        E_SERVICIO -> T_SERVICIO : SELECT ... WHERE activo = true
        T_SERVICIO --> E_SERVICIO : servicios válidos
        E_SERVICIO --> CTRL : servicios válidos
    end
else Borrador o inactivo
    CTRL -> E_SERVICIO : validarServicios(ids)
    E_SERVICIO -> T_SERVICIO : SELECT ... WHERE activo = true
    T_SERVICIO --> E_SERVICIO : servicios válidos
    E_SERVICIO --> CTRL : servicios válidos
end

group Transacción de guardado
    CTRL -> T_PAQUETE : fn_generar_codigo_paquete(prefijo)
    T_PAQUETE --> CTRL : código único

    CTRL -> E_PAQUETE : guardar()
    E_PAQUETE -> T_PAQUETE : INSERT o UPDATE
    T_PAQUETE --> E_PAQUETE : id_paquete

    CTRL -> T_PARADA : DELETE e INSERT ordenado
    T_PARADA --> CTRL : paradas guardadas

    CTRL -> E_PAQUETE_SERVICIO : reemplazar(ids)
    E_PAQUETE_SERVICIO -> T_PAQUETE_SERVICIO : DELETE e INSERT
    T_PAQUETE_SERVICIO --> E_PAQUETE_SERVICIO : vínculos guardados
end

CTRL --> UI : paquete guardado
UI --> ADM : confirmación

note right of CTRL
    El borrador se puede guardar incompleto. Un paquete activo
    siempre tiene destino, descripción, itinerario y al menos un
    servicio; si falta uno, el disparador de publicación lo rechaza.
end note

note right of E_PAQUETE_SERVICIO
    Los servicios son la lista de lo que cubre el precio:
    desayuno, transporte, alojamiento, guía, entradas, etc.
    El itinerario es el relato día por día.
end note
@enduml
