@startuml
title HU-09 · Modificar fechas o capacidad de una salida
' La capacidad no puede quedar por debajo de los pasajeros ya reservados y
' los clientes afectados reciben aviso (HU-16).
hide footbox
autonumber
skinparam maxMessageSize 175

actor "Administrador" as ADM
boundary "IU-09 · Modificar salida" as UI <<interfaz>>
control "ControlSalidas" as CTRL <<control>>
entity "Salida" as E_SALIDA <<entidad>>
entity "Reserva" as E_RESERVA <<entidad>>
entity "HistorialSalida" as E_HISTORIAL <<entidad>>
entity "Notificacion" as E_NOTIFICACION <<entidad>>
database "salida" as T_SALIDA <<tabla>>
database "reserva" as T_RESERVA <<tabla>>
database "historial_salida" as T_HISTORIAL <<tabla>>

ADM -> UI : selecciona salida y nuevos datos
UI -> CTRL : modificarSalida(idSalida, cambios)

group Transacción de actualización
    CTRL -> E_SALIDA : bloquear(idSalida)
    E_SALIDA -> T_SALIDA : SELECT ... FOR UPDATE
    T_SALIDA --> E_SALIDA : salida actual
    E_SALIDA --> CTRL : datos actuales

    alt Salida realizada o cancelada
        CTRL --> UI : error «La salida no admite cambios»
        UI --> ADM : mostrar el motivo
    else Salida modificable
        CTRL -> E_SALIDA : validarFechasYEstado()
        E_SALIDA --> CTRL : transición y duración válidas

        CTRL -> E_RESERVA : contarPasajerosActivos(idSalida)
        E_RESERVA -> T_RESERVA : SELECT SUM(cantidad_pasajeros)\nWHERE estado IN ('pendiente', 'confirmada')
        T_RESERVA --> E_RESERVA : pasajeros ocupados
        E_RESERVA --> CTRL : ocupados

        alt Nueva capacidad menor a los pasajeros reservados
            CTRL --> UI : error «Capacidad menor a la reservada»
            UI --> ADM : rechazar el cambio
        else Cambio válido
            CTRL -> E_SALIDA : aplicarCambios(cambios)
            E_SALIDA -> T_SALIDA : UPDATE ...
            T_SALIDA --> E_SALIDA : fila actualizada
            CTRL -> E_HISTORIAL : registrarCambio(campo, anterior, nuevo)
            E_HISTORIAL -> T_HISTORIAL : INSERT ...
            T_HISTORIAL --> E_HISTORIAL : id_historial
            E_HISTORIAL --> CTRL : auditoría registrada
            CTRL --> UI : salida actualizada
            UI --> ADM : confirmación y nuevo cupo
        end
    end
end

alt Cambió la fecha o la capacidad
    CTRL -> E_RESERVA : listarReservasAfectadas(idSalida)
    E_RESERVA -> T_RESERVA : SELECT ... WHERE estado IN ('pendiente', 'confirmada')
    T_RESERVA --> E_RESERVA : reservas afectadas
    E_RESERVA --> CTRL : clientes vinculados
    CTRL -> E_NOTIFICACION : avisarClientes(idSalida, cambios)
    E_NOTIFICACION -> E_NOTIFICACION : aviso por fecha, cupo o código
    E_NOTIFICACION --> CTRL : avisos enviados
    CTRL --> UI : resumen de avisos enviados
    UI --> ADM : clientes notificados
else No cambió la fecha ni la capacidad
    CTRL --> UI : sin avisos pendientes
end

note right of CTRL
    Una salida realizada o cancelada no se modifica.
    Si cambia la fecha, las reservas conservan su
    vínculo con la salida. La capacidad no puede ser
    menor que los pasajeros activos, contados en los
    dos canales. Se auditan fecha, retorno, capacidad,
    precio, punto de encuentro y estado; la cancelación
    exige motivo.
end note
@enduml
