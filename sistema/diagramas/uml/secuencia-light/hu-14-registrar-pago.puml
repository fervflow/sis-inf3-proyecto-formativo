@startuml
title HU-14 · Registro de anticipos y saldos (versión ligera)
hide footbox

actor "Turista" as TUR
boundary "IU-14" as UI <<interfaz>>
control "ControlPagos" as CTRL <<control>>
entity "Pago" as E_PAGO <<entidad>>
database "pago" as T_PAGO <<tabla>>

TUR -> UI : registra monto, tipo, método y referencia
UI -> CTRL : registrarPago(datos)
CTRL -> E_PAGO : validarTipoYMonto(tipo, monto)
E_PAGO --> CTRL : validación correcta
CTRL -> E_PAGO : crear(pago, estado = 'registrado')
E_PAGO -> T_PAGO : INSERT ...
T_PAGO --> E_PAGO : id_pago
E_PAGO --> CTRL : pago registrado
CTRL --> UI : comprobante y saldo pendiente
UI --> TUR : pago pendiente de validación
@enduml
